PORT=8080
BACKEND_URL=http://localhost
CLIENT_URL=http://localhost:3000

# Airtable vars
# See https://github.com/nicmart-dev/feedmenow/wiki/Install-instructions#airtable-database
AIRTABLE_PERSONAL_ACCESS_TOKEN=your_personal_access_token_here
AIRTABLE_BASE_ID=airtable_id
AIRTABLE_READ_ACCESS_TOKEN=airtable_read_access_token

#Airtable Table IDs
AIRTABLE_COOKINGTIME_ID=
AIRTABLE_DIET_ID=
AIRTABLE_INTOLERANCE_ID=

# N8N vars
N8N_HOST=https://n8n.nicmart.synology.me

N8N_WEBHOOK_URL_PROD=${N8N_HOST}/webhook
N8N_WEBHOOK_URL_TEST=${N8N_HOST}/webhook-test
N8N_WEBHOOK_URL=${N8N_WEBHOOK_URL_TEST}

# Gemini API vars
JWT=your_JWT_for_N8N_workflow
N8N_API_KEY=your_n8n_api_key